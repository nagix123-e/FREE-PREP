{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAT Practice Simulator",
  "version": "1.2.2",
  "identifier": "com.satpracticesimulator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAT Practice Simulator",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "shortDescription": "A local SAT practice simulator for importing CSV-based practice tests.",
    "longDescription": "SAT Practice Simulator is an unofficial local desktop app for importing CSV-based practice tests, taking practice exams, reviewing answers, and tracking estimated practice scores."
  }
}
