{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FREE PREP",
  "version": "1.3.0",
  "identifier": "com.satpracticesimulator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FREE PREP — Free Practice Simulator for the SAT® Exam",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../public/marketplace/": "marketplace/"
    },
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "shortDescription": "Free Practice Simulator for the SAT® Exam.",
    "longDescription": "FREE PREP is a free practice simulator for the SAT® Exam. Not affiliated with or endorsed by College Board."
  }
}
