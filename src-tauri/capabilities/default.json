{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "sql:allow-load",
      "allow": [
        {
          "db": "sqlite:sat-practice-simulator.db"
        }
      ]
    }
  ]
}
